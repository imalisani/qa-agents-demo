{
  "name": "agentic-quality-engineering-demo",
  "version": "1.0.0",
  "private": true,
  "description": "A portfolio-ready Agentic Quality Engineering experiment using specialized QA agents, reusable skills, and Playwright.",
  "type": "module",
  "scripts": {
    "start": "node app/server.mjs",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report reports/playwright-html",
    "test:allure": "playwright test && npm run allure:generate",
    "test:portfolio": "cross-env PLAYWRIGHT_VIDEO=on playwright test && npm run allure:generate",
    "allure:generate": "allure generate allure-results --clean -o reports/allure",
    "allure:open": "allure open reports/allure",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "validate": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.11.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
