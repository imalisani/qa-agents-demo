{
  "name": "agentic-quality-engineering-demo",
  "version": "1.0.0",
  "private": true,
  "description": "A portfolio-ready Agentic Quality Engineering experiment using specialized QA agents, reusable skills, and Playwright.",
  "type": "module",
  "scripts": {
    "start": "node app/server.mjs",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report reports/playwright-html",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "validate": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
